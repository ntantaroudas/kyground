# Copy to .env and fill in. .env is git-ignored: never commit or share it.

# Optional: read-only data API of the DASK platform (X-API-Key header). Needed only for the API probe, the live
# check of C2 and the conformance replay; every experiment runs without it.
DASK_API_KEY=

# Answer + router models (gpt-5-nano / gpt-5-mini) and embeddings
OPENAI_API_KEY=

# Optional: only for `kyground judge`, the judge through the Anthropic API. The study grades with Claude sub-agents
# inside a Claude session instead (kyground judge-export / judge-import), which needs no key.
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible server for Llama-Krikri-8B (vLLM / Ollama); often not needed
COMPAT_API_KEY=
